# ==============================================================================
# Production Environment Variables Example
# Copy this file to .env.production or set in your production CI/CD environment
# ==============================================================================

# Database Settings (PostgreSQL)
POSTGRES_DB=data_quality_platform
POSTGRES_USER=dqp_user
POSTGRES_PASSWORD=replace_with_a_strong_password_in_production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Application Settings
DJANGO_SECRET_KEY=replace_with_a_secure_random_django_secret_key_minimum_50_chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,yourdomain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Storage Directory inside container
STORAGE_DIR=/app/data/storage
MAX_UPLOAD_SIZE_MB=25
